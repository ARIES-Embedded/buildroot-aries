 arch/arm/dts/stm32mp25-pinctrl.dtsi           |  61 ++
 arch/arm/dts/stm32mp255d-msmp2evk-resmem.dtsi | 195 +++++
 arch/arm/dts/stm32mp255d-msmp2evk-u-boot.dtsi |  38 +
 arch/arm/dts/stm32mp255d-msmp2evk.dts         | 721 ++++++++++++++++++
 board/st/stm32mp2/stm32mp2.c                  |  92 ++-
 configs/stm32mp255d-msmp2evk_defconfig        | 200 +++++
 drivers/video/stm32/stm32_lvds.c              |   3 +-
 8 files changed, 1302 insertions(+), 9 deletions(-)
 create mode 100644 arch/arm/dts/stm32mp255d-msmp2evk-resmem.dtsi
 create mode 100644 arch/arm/dts/stm32mp255d-msmp2evk-u-boot.dtsi
