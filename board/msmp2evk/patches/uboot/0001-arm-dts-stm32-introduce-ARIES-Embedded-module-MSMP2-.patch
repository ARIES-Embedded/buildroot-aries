+bool detect_am800480r2_ds90cf386(void)
+{
+	ofnode node;
+	unsigned char id;
+	int ret;
+
+	node = ofnode_by_compatible(ofnode_null(), "edt,edt-ft5506");
+	if (!ofnode_valid(node))
+		return false;
+
+	/*
+	 * Chip identifications is tricky. Therefore we just check
+	 * if we can read from that I2C address.
+	 */
+	ret = i2c_read(node, 0xa3, &id, sizeof(id), 1);
+	if (ret)
+		return false;
+
+	return id ? true : false;
+}
